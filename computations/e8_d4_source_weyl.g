W:=Group(PermList([1,7,8,9,10,19,2,3,4,5,11,12,13,14,20,21,22,23,6,15,16,17,18,24]),PermList([2,1,3,4,6,5,7,11,12,15,8,9,16,17,10,13,14,18,20,19,21,22,24,23]),PermList([1,4,5,2,3,6,9,10,7,8,14,12,13,11,17,18,15,16,19,22,23,20,21,24]),PermList([1,3,2,5,4,6,8,7,10,9,11,13,12,14,16,15,18,17,19,21,20,23,22,24]),PermList([1,2,3,7,8,11,4,5,9,10,6,12,13,19,15,16,20,21,14,17,18,22,23,24]),PermList([1,2,7,3,8,11,4,9,5,10,12,6,19,13,15,20,16,21,14,17,22,18,23,24]));;
ct:=CharacterTable(W);; dd:=List(Irr(ct),chi->chi[1]);;
