lroots:=[3, 9, 28, 45, 64, 70];;
WL:=Group(List([45, 64],i->refs[i]),());;
NW:=Stabilizer(W,lroots,OnSets);;
if ForAll(GeneratorsOfGroup(NW),x->x^f*x^-1 in WL) then FW:=NW; else fix:=Filtered(Elements(NW),x->x^f*x^-1 in WL);FW:=Group(fix);fi;
Q:=FactorGroup(FW,WL);;
Print("cyclic_d3|FULL|",Size(Q),"\n");
Print("ACTION|cyclic_d3|FULL|",List(GeneratorsOfGroup(FW),g->List([57, 47, 43, 40, 38, 37],i->i^g)),"\n");
NC:=Stabilizer(WC,lroots,OnSets);;K:=Intersection(NC,WL);;
if ForAll(GeneratorsOfGroup(NC),x->x^f*x^-1 in K) then FC:=NC; else fix:=Filtered(Elements(NC),x->x^f*x^-1 in K);FC:=Group(fix);fi;Q:=FactorGroup(FC,K);;
Print("cyclic_d3|REG|",Size(Q),"|",Length(Irr(Q)),"|",StructureDescription(Q),"\n");
Print("ACTION|cyclic_d3|REG|",List(GeneratorsOfGroup(FC),g->List([57, 47, 43, 40, 38, 37],i->i^g)),"\n");
NC:=Stabilizer(Wbar,lroots,OnSets);;K:=Intersection(NC,WL);;
if ForAll(GeneratorsOfGroup(NC),x->x^f*x^-1 in K) then FC:=NC; else fix:=Filtered(Elements(NC),x->x^f*x^-1 in K);FC:=Group(fix);fi;Q:=FactorGroup(FC,K);;
Print("cyclic_d3|NAT|",Size(Q),"|",Length(Irr(Q)),"|",StructureDescription(Q),"\n");
Print("ACTION|cyclic_d3|NAT|",List(GeneratorsOfGroup(FC),g->List([57, 47, 43, 40, 38, 37],i->i^g)),"\n");
QUIT;
