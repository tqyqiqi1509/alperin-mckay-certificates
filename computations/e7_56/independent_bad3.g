H2:=Group(PermList([1, 3, 2, 4, 5, 6, 7, 8, 9, 11, 10, 12, 13, 15, 14, 16, 18, 17, 19, 20, 22, 21, 23, 25, 24, 26, 28, 27, 29, 30, 32, 31, 34, 33, 35, 36, 38, 37, 39, 41, 40, 42, 43, 45, 44, 46, 47, 48, 49, 51, 50, 52, 53, 54, 56, 55, 57, 58, 60, 59, 63, 65, 61, 66, 62, 64, 68, 67, 69, 70, 72, 71, 73, 74, 75, 77, 76, 78, 79, 80, 81, 83, 82, 84, 85, 87, 86, 88, 90, 89, 91, 92, 94, 93, 96, 95, 97, 98, 100, 99, 101, 103, 102, 104, 106, 105, 107, 108, 110, 109, 111, 113, 112, 114, 115, 117, 116, 118, 119, 120, 121, 122, 123, 125, 124, 126]),PermList([1, 2, 4, 3, 5, 6, 7, 8, 10, 9, 11, 12, 14, 13, 15, 16, 17, 20, 21, 18, 19, 22, 24, 23, 25, 26, 27, 30, 31, 28, 29, 32, 33, 36, 37, 34, 35, 38, 39, 40, 42, 41, 43, 44, 46, 45, 47, 48, 49, 50, 52, 51, 53, 54, 55, 57, 56, 61, 62, 67, 58, 59, 63, 64, 68, 69, 60, 65, 66, 71, 70, 72, 73, 74, 76, 75, 77, 78, 79, 80, 82, 81, 83, 84, 86, 85, 87, 88, 89, 92, 93, 90, 91, 94, 95, 98, 99, 96, 97, 100, 101, 102, 104, 103, 105, 108, 109, 106, 107, 110, 111, 112, 114, 113, 115, 116, 118, 117, 119, 120, 121, 122, 124, 123, 125, 126]));;
