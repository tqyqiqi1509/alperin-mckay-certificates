LoadPackage("ctbllib");;
SetInfoLevel(InfoWarning,0);;
Read("computations/exceptional_covers/external_data/F22d2G1-p3510B0.g1");;
Read("computations/exceptional_covers/external_data/F22d2G1-p3510B0.g2");;
ff:=Group(b11,b21);;Assert(0,Size(ff)=2*64561751654400);
yy:=Stabilizer(ff,1);;gg:=DerivedSubgroup(yy);;
Assert(0,Size(yy)=36787322880 and Size(gg)=18393661440 and IsPerfectGroup(gg));
Assert(0,Centralizer(yy,gg)=Centre(gg));;
zz:=Centre(gg);;Assert(0,Size(zz)=2);;zi:=First(Elements(zz),x->Order(x)=2);;
Print("U6_ACTUAL|ambient=",Size(ff),"|Y=",Size(yy),"|G=",Size(gg),"|centre=",Size(zz),"\n");
pp:=SylowSubgroup(gg,3);; mm:=Normalizer(gg,pp);;hh:=Normalizer(yy,pp);;
pd:=DerivedSubgroup(pp);;cc:=Centralizer(gg,pp);;
Print("U6_NORMALIZER|P=",Size(pp),"|N=",Size(mm),"|H=",Size(hh),"|Pderived=",Size(pd),"|C=",Size(cc),"|ZP=",Size(Centre(pp)),"\n");
Assert(0,Size(pp)=729 and Size(mm)=11664 and Size(hh)=23328);
Assert(0,cc=ClosureGroup(Centre(pp),zz));
qh:=NaturalHomomorphismByNormalSubgroup(hh,pd);;ql:=Image(qh,mm);;qu:=Image(qh);;qz:=Image(qh,zi);;
Print("U6_QUOTIENT|lower=",Size(ql),"|upper=",Size(qu),"\n");
ct:=CharacterTable(ql);;yt:=CharacterTable(qu);;fu:=FusionConjugacyClasses(ct,yt);;
cp:=[];;
for j in [1..Length(fu)] do
 ids:=Positions(fu,fu[j]);;Assert(0,Length(ids)<=2);
 if Length(ids)=1 then cp[j]:=j;else cp[j]:=First(ids,x->x<>j);fi;
od;
vals:=List(Irr(ct),ValuesOfClassFunction);;rp:=List(vals,v->Position(vals,v{cp}));;
zpos:=PositionProperty(ConjugacyClasses(ql),c->qz in c);;
ids:=Filtered([1..Length(vals)],j->vals[j][1] mod 3<>0 and vals[j][zpos]=-vals[j][1]);;
Print("U6_FAITHFUL_LOCAL|k0=",Length(ids),"|degrees=",Collected(List(ids,j->vals[j][1])),"|outer_orbits=",Collected(List(Orbits(Group(PermList(rp)),ids),Length)),"|rows=",ids,"|images=",rp{ids},"\n");
Assert(0,Length(ids)=18 and Number(ids,j->rp[j]=j)=12);
Read("computations/exceptional_covers/actual_c2_pairing.g");;
ActualC2Pair63("2.U6(2)",6,ct,ids,rp);
Print("FRESH_U6_FI22_ACTUAL_NORMALIZER_COMPLETE\n");
QUIT;
